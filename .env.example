# Supabase Cloud Database Configuration
# Dapatkan Project URL dan Anon Public Key dari Dashboard Supabase Anda: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# PIN Akses Admin Panel (Shortcut: Alt + A)
VITE_ADMIN_PIN=1234
